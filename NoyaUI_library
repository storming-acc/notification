-- ========== FOLDER MANAGEMENT ==========
local function ensureFolder(path)
    if not isfolder then return false end
    if not isfolder(path) then
        local success, err = pcall(function() makefolder(path) end)
        if not success then
            warn("[NoyaUI] Failed to create folder: " .. path .. " - " .. tostring(err))
            return false
        end
    end
    return true
end

local NOYA_FOLDER = "NoyaUI"
local ASSETS_FOLDER = NOYA_FOLDER .. "/assets"
if ensureFolder(NOYA_FOLDER) then
    ensureFolder(ASSETS_FOLDER)
end

-- ========== HELPERS ==========
local function getDirectDriveLink(url)
    if type(url) ~= "string" then return url end
    local fileId = string.match(url, "/file/d/([%w%-_]+)")
    if not fileId then
        fileId = string.match(url, "[?&]id=([%w%-_]+)")
    end
    if fileId then
        return "https://drive.google.com/uc?export=download&id=" .. fileId
    end
    return url
end

local decalCache = {}
local function getImageId(decalId)
    if type(decalId) ~= "number" and not tostring(decalId):match("^%d+$") then return nil end
    local id = tonumber(decalId)
    if decalCache[id] then return decalCache[id] end
    local url = "https://assetdelivery.roblox.com/v1/asset/?id=" .. tostring(id)
    local success, content = pcall(function() return game:HttpGet(url) end)
    if success and content then
        local imageId = string.match(content, "<url>.-id=(%d+)")
        if imageId then
            decalCache[id] = "rbxassetid://" .. imageId
            return decalCache[id]
        end
    end
    return nil
end

function resolveImageInput(raw)
    if raw == nil then return nil end
    local rawStr = tostring(raw)
    rawStr = getDirectDriveLink(rawStr)
    if rawStr:match("^rbxasset") then return rawStr end
    if rawStr:match("^%d+$") then
        local imageAsset = getImageId(rawStr)
        if imageAsset then return imageAsset end
        return "rbxassetid://" .. rawStr
    end
    if rawStr:match("^https?://") then
        if not isfile or not writefile or not getcustomasset then
            warn("[NoyaUI] Executor does not support custom assets. Using raw URL.")
            return rawStr
        end
        local fileName = rawStr:match("([^/]+)$") or "image"
        fileName = fileName:gsub("[^%w%-_%.]", "_")
        if #fileName > 50 then fileName = fileName:sub(1, 50) end
        if not fileName:match("%.[^.]+$") then fileName = fileName .. ".png" end
        local fullPath = ASSETS_FOLDER .. "/" .. fileName
        if not isfile(fullPath) then
            local success, response = pcall(function() return game:HttpGet(rawStr) end)
            if success and response then
                pcall(function() writefile(fullPath, response) end)
            else
                warn("[NoyaUI] Failed to download image from URL: " .. rawStr)
                return rawStr
            end
        end
        local success, asset = pcall(function() return getcustomasset(fullPath) end)
        if success and asset then return asset end
        return rawStr
    end
    return rawStr
end

function BuildElement(class, parent, props)
    local el = Instance.new(class, parent)
    for k, v in pairs(props) do
        if k == "UICorner" then
            Instance.new("UICorner", el)
        elseif k == "RichText" and class:match("Text") then
            el.RichText = v
        else
            el[k] = v
        end
    end
    return el
end

-- ========== RESPONSIVE POSITIONS & STACKING ==========
local HORIZONTAL_SPACING = 220
local VERTICAL_SPACING = 10

local function prevH_Offset(notif)
    return (notif.Frame and notif.Frame.Size.Y.Offset > 0) and notif.Frame.Size.Y.Offset or 55
end

function computePosition(notifData, indexInGroup)
    local data = notifData.positionData
    local notifWidth = notifData.Frame.Size.X.Offset
    local notifHeight = notifData.Frame.Size.Y.Offset
    local posType = data.posType
    
    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)
    local marginX = 25
    local marginY = 25
    
    local list = notificationsByPosition[posType] or {}
    
    -- Accumulate exact heights of preceding notifications
    local accumulatedHeight = 0
    for j = 1, indexInGroup - 1 do
        local prevNotif = list[j]
        if prevNotif and prevNotif.Frame and prevNotif.Frame.Parent then
            accumulatedHeight = accumulatedHeight + prevH_Offset(prevNotif) + VERTICAL_SPACING
        end
    end

    local baseX = 0
    local baseY = 0

    if posType == "TopRight" then
        baseX = viewport.X - notifWidth - marginX
        baseY = marginY + accumulatedHeight
    elseif posType == "TopLeft" then
        baseX = marginX
        baseY = marginY + accumulatedHeight
    elseif posType == "BottomRight" then
        baseX = viewport.X - notifWidth - marginX
        baseY = viewport.Y - notifHeight - marginY - accumulatedHeight
    elseif posType == "BottomLeft" then
        baseX = marginX
        baseY = viewport.Y - notifHeight - marginY - accumulatedHeight
    elseif posType == "Center" then
        baseX = (viewport.X / 2) - (notifWidth / 2)
        baseY = (viewport.Y / 2) - (notifHeight / 2)
        if indexInGroup > 1 then
            if indexInGroup % 2 == 0 then
                baseX = baseX - (math.floor(indexInGroup / 2) * HORIZONTAL_SPACING)
            else
                baseX = baseX + (math.floor((indexInGroup - 1) / 2) * HORIZONTAL_SPACING)
            end
        end
    else
        baseX = viewport.X - notifWidth - marginX
        baseY = viewport.Y - notifHeight - marginY - accumulatedHeight
    end

    return baseX, baseY
end

function updatePositionsForPosition(positionKey)
    local list = notificationsByPosition[positionKey]
    if not list then return end
    for i, notif in ipairs(list) do
        if notif and notif.Frame then
            local targetX, targetY = computePosition(notif, i)
            TweenService:Create(notif.Frame, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
                Position = UDim2.new(0, targetX, 0, targetY)
            }):Play()
        end
    end
end

-- ========== GLOBAL DISMISS ==========
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == shared.NoyaDismissKey then
        local allNotifs = {}
        for _, list in pairs(notificationsByPosition) do
            for _, notif in ipairs(list) do
                if notif then table.insert(allNotifs, notif) end
            end
        end
        for _, notif in ipairs(allNotifs) do
            if activeClosers[notif] then task.spawn(activeClosers[notif], true) end
        end
    end
end)

-- ========== QUEUE PROCESSING ==========
local function processQueue()
    while #notificationQueue > 0 do
        local queued = table.remove(notificationQueue, 1)
        if not queued.closed then
            local posKey = queued.positionType or "BottomRight"
            local list = notificationsByPosition[posKey]
            if not list then list = {} notificationsByPosition[posKey] = list end
            if #list < 5 then
                local notifData = NoyaUI:Notify(queued.config)
                if notifData and queued.updateCallback then
                    queued.updateCallback(notifData)
                end
            else
                table.insert(notificationQueue, 1, queued)
                break
            end
        end
    end
end

-- ========== GENERATE UNIQUE ID ==========
function NoyaUI:GenerateID()
    notificationIdCounter = notificationIdCounter + 1
    return "Noya_" .. tostring(notificationIdCounter)
end

