        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextYAlignment = Enum.TextYAlignment.Center,
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json", Enum.FontWeight.Regular, Enum.FontStyle.Normal),
        BackgroundTransparency = 1, Size = UDim2.new(0, 20, 0, 20), AnchorPoint = Vector2.new(0, 0),
        Position = isLeftSide and UDim2.new(0, 10, 0, 0) or UDim2.new(0, notifWidth - 30, 0, 0),
        Text = "x"
    })

    local FrameEffect = BuildElement("Frame", MainFrame, {
        Name = "FrameEffect", BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        Size = UDim2.new(0, notifWidth, 0, 20),
        Position = UDim2.new(0, 0, 0, notifHeight - 20), BackgroundTransparency = 0.85, UICorner = true
    })
    BuildElement("Frame", FrameEffect, {
        Name = "FrameEffect2", BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        Size = UDim2.new(0, notifWidth, 0, 12)
    })

    if not customImage then
        BuildElement("ImageLabel", MainFrame, {
            Name = "TypeIcon", BorderSizePixel = 0, BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            ImageColor3 = typeColor, Image = iconId,
            Size = UDim2.new(0, 15, 0, 15), BackgroundTransparency = 1,
            Position = isLeftSide and UDim2.new(1, -18, 0, 3) or UDim2.new(0, 3, 0, 3)
        })
    end

    if onHoverEnter then MainFrame.MouseEnter:Connect(function() pcall(onHoverEnter) end) end
    if onHoverLeave then MainFrame.MouseLeave:Connect(function() pcall(onHoverLeave) end) end

    -- ====== Dismiss & Animation Logic ======
    local isClosing = false
    local isSticky = (duration == 0 or duration == math.huge)
    local tweenBar
    if isSticky then
        DurationFrame.Visible = false
        if TimerLabel then TimerLabel.Visible = false end
    else
        tweenBar = TweenService:Create(DurationFrame, TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 0, 0, 5)
        })
    end

    local notifData = {
        Frame = MainFrame, Gui = ScreenGui, id = id, closed = false,
        positionData = { isBottom = isBottom, posType = positionType },
        config = config, progressBar = ProgressFill, duration = duration,
        durationFrame = DurationFrame, timerLabel = TimerLabel,
        closeFunction = nil, positionType = positionType, groupKey = groupKey,
    }

    local closeUI
    closeUI = function(forcedByButton)
        if isClosing then return end
        isClosing = true
        notifData.closed = true
        activeClosers[notifData] = nil
        if tweenBar and tweenBar.PlaybackState == Enum.PlaybackState.Playing then
            tweenBar:Cancel()
        end
        if notifData.timerConn then
            notifData.timerConn:Disconnect()
            notifData.timerConn = nil
        end

        if groupKey and notificationGroups[groupKey] then
            notificationGroups[groupKey].count = math.max(0, notificationGroups[groupKey].count - 1)
            if notificationGroups[groupKey].count == 0 then
                notificationGroups[groupKey] = nil
            end
        end

        if forcedByButton then
            TweenService:Create(CloseButton, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                TextColor3 = Color3.fromRGB(255, 82, 82),
                Rotation = 360,
                TextTransparency = 1
            }):Play()
            TweenService:Create(DurationFrame, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                Size = UDim2.new(0, 0, 0, 5),
                BackgroundColor3 = Color3.fromRGB(255, 82, 82)
            }):Play()
            task.wait(0.35)
        end

        if onClose then pcall(onClose) end

        local list = notificationsByPosition[positionType]
        if list then
            for i, v in ipairs(list) do
                if v == notifData then
                    table.remove(list, i)
                    break
                end
            end
            updatePositionsForPosition(positionType)
        end

        if MainFrame and MainFrame.Parent then
            local endXOffset = isLeftSide and -notifWidth - 50 or 50
            local endScaleX = isLeftSide and 0 or 1
            local outTween = TweenService:Create(MainFrame, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
                Position = UDim2.new(endScaleX, endXOffset, 0, MainFrame.Position.Y.Offset)
            })
            outTween:Play()
            outTween.Completed:Connect(function() ScreenGui:Destroy() end)
        end

        task.spawn(processQueue)
    end
    notifData.closeFunction = closeUI

    -- ====== Buttons ======
    if #buttons > 0 then
        local buttonRow = BuildElement("Frame", MainFrame, {
            Name = "ButtonRow", BorderSizePixel = 0, BackgroundTransparency = 1,
            Size = UDim2.new(1, -20, 0, BUTTON_HEIGHT),
            Position = UDim2.new(0, 10, 0, currentY + 2)
        })
        BuildElement("UIListLayout", buttonRow, {
            FillDirection = Enum.FillDirection.Horizontal,
            HorizontalAlignment = Enum.HorizontalAlignment.Center,
            VerticalAlignment = Enum.VerticalAlignment.Center,
            Padding = UDim.new(0, 8)
        })
        local tooltipGui = nil
        for i, btn in ipairs(buttons) do
            local btnText = btn.Text or "Button"
            local callback = btn.Callback
            local btnColor = btn.ButtonColor or Color3.fromRGB(255,255,255)
            local textColor = btn.TextColor or Color3.fromRGB(255,255,255)
            local btnIcon = btn.Icon and resolveImageInput(btn.Icon)
            local tooltipText = btn.Tooltip

            local btnFrame = BuildElement("TextButton", buttonRow, {
                Name = "Btn_" .. i,
                Size = UDim2.new(#buttons == 1 and 0.6 or 0.5, -4, 1, 0),
                BackgroundTransparency = 0.85,
                BackgroundColor3 = btnColor,
                Text = btnText,
                TextColor3 = textColor,
                TextSize = 12,
                FontFace = Font.new("rbxasset://fonts/families/FredokaOne.json", Enum.FontWeight.SemiBold),
                BorderSizePixel = 0,
                UICorner = true
            })
            if btnIcon then
                local iconLabel = BuildElement("ImageLabel", btnFrame, {
                    Name = "BtnIcon", Size = UDim2.new(0, 14, 0, 14),
                    Position = UDim2.new(0, 4, 0.5, 0), AnchorPoint = Vector2.new(0,0.5),
                    BackgroundTransparency = 1, Image = btnIcon,
                    ImageColor3 = textColor
                })
                btnFrame.Text = "  " .. btnText
                btnFrame.TextXAlignment = Enum.TextXAlignment.Left
            end

            btnFrame.MouseButton1Click:Connect(function()
                if type(callback) == "function" then
                    local success, result = pcall(callback, function()
                        if not notifData.closed then closeUI(true) end
                    end)
                    if success and result == false then
                        return
                    elseif not success then
                        warn("[NoyaUI] Button callback error:", result)
                    end
                end
                closeUI(true)
            end)

            if tooltipText then
                local conns = {}
                local enterConn = btnFrame.MouseEnter:Connect(function()
                    if not tooltipGui then
                        tooltipGui = Instance.new("ScreenGui")
                        tooltipGui.Parent = ParentTarget
                        tooltipGui.IgnoreGuiInset = true
                        local tip = Instance.new("TextLabel")
                        tip.Parent = tooltipGui
                        tip.Size = UDim2.new(0, 100, 0, 20)
                        tip.BackgroundColor3 = Color3.fromRGB(40,40,40)
                        tip.TextColor3 = Color3.fromRGB(255,255,255)
                        tip.Text = tooltipText
                        tip.TextSize = 12
                        tip.Font = Enum.Font.Gotham
                        tip.BackgroundTransparency = 0.1
                        tip.BorderSizePixel = 0
                        tip.Visible = true
                        tip.Position = UDim2.new(0, btnFrame.AbsolutePosition.X + btnFrame.AbsoluteSize.X/2 - 50, 0, btnFrame.AbsolutePosition.Y - 25)
                        local moveConn = RunService.RenderStepped:Connect(function()
                            if not btnFrame.Parent then
                                moveConn:Disconnect()
                                if tooltipGui then tooltipGui:Destroy() end
                                return
                            end
                            tip.Position = UDim2.new(0, btnFrame.AbsolutePosition.X + btnFrame.AbsoluteSize.X/2 - 50, 0, btnFrame.AbsolutePosition.Y - 25)
                        end)
                        conns.moveConn = moveConn
                    end
                end)
                local leaveConn = btnFrame.MouseLeave:Connect(function()
                    if tooltipGui then
                        tooltipGui:Destroy()
                        tooltipGui = nil
                    end
                    if conns.moveConn then
                        conns.moveConn:Disconnect()
                        conns.moveConn = nil
                    end
                end)
                tooltipConnections[btnFrame] = { enter = enterConn, leave = leaveConn }
            end

            btnFrame.MouseEnter:Connect(function()
                TweenService:Create(btnFrame, TweenInfo.new(0.1), {BackgroundTransparency = 0.7}):Play()
            end)
            btnFrame.MouseLeave:Connect(function()
                TweenService:Create(btnFrame, TweenInfo.new(0.1), {BackgroundTransparency = 0.85}):Play()
            end)
        end
        currentY = currentY + BUTTON_HEIGHT + 4
    end

    -- Timer loop
    if not isSticky and TimerLabel then
        local startTime = tick()
        local timerConn = RunService.RenderStepped:Connect(function()
            if isClosing or not TimerLabel.Parent then
                timerConn:Disconnect()
                return
            end
            local elapsed = tick() - startTime
            local remaining = math.max(0, duration - elapsed)
            TimerLabel.Text = string.format("%.0fs", remaining)
            if remaining <= 0 then
                TimerLabel.Text = ""
            end
        end)
        notifData.timerConn = timerConn
    end

    -- Insert into active list
    local newIndex = #positionList + 1
    local finalX, finalY = computePosition(notifData, newIndex)
    table.insert(positionList, notifData)

    local startXOffset = isLeftSide and -notifWidth - 50 or 50
    local startScaleX = isLeftSide and 0 or 1
    MainFrame.Position = UDim2.new(startScaleX, startXOffset, 0, finalY)
    updatePositionsForPosition(positionType)

    local tweenIn = TweenService:Create(MainFrame, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
        Position = UDim2.new(0, finalX, 0, finalY)
    })
    tweenIn:Play()

    -- Sound
    local sound = Instance.new("Sound", MainFrame)
    sound.Volume = 0.5
    if soundId then
        sound.SoundId = soundId
    else
        if notifType == "Success" then
            sound.SoundId = "rbxassetid://130201387574815"
        elseif notifType == "Error" then
            sound.SoundId = "rbxassetid://133843340754810"
        elseif notifType == "Warn" then
            sound.SoundId = "rbxassetid://107294127858629"
        else
            sound.SoundId = "rbxassetid://130201387574815"
        end
    end
    sound:Play()
    Debris:AddItem(sound, 2)

    tweenIn.Completed:Connect(function()
        if not isClosing and tweenBar then tweenBar:Play() end
    end)

    if not isSticky then
        tweenBar.Completed:Connect(function()
            if not isClosing then closeUI(false) end
        end)
    end

    activeClosers[notifData] = closeUI
    CloseButton.MouseButton1Click:Connect(function() closeUI(true) end)

    if not isSticky then
        MainFrame.MouseEnter:Connect(function()
            if tweenBar and tweenBar.PlaybackState == Enum.PlaybackState.Playing then
                tweenBar:Pause()
            end
        end)
        MainFrame.MouseLeave:Connect(function()
            if tweenBar and tweenBar.PlaybackState == Enum.PlaybackState.Paused then
                tweenBar:Play()
            end
        end)
    end

    notifData.progressBar = ProgressFill
    return notifData
end

-- ========== MAIN ROUTER NOTIFY ==========
function NoyaUI:Notify(Config)
    Config = Config or {}
    local style = string.lower(tostring(Config.Style or "v2"))

    if style == "v1" or style == "wind" or style == "minimal" then
        return self:NotifyV1(Config)
    else
        return self:NotifyV2(Config)
    end
end

-- ========== UPDATE NOTIFICATION ==========
function NoyaUI:Update(id, newConfig)
    if not id then return nil end

    for _, list in pairs(notificationsByPosition) do
        for _, notif in ipairs(list) do
            if notif and notif.id == id and not notif.closed and notif.Frame then
                if newConfig.Title then
                    local titleLabel = notif.Frame:FindFirstChild("NotificationTitle")
                    if titleLabel then titleLabel.Text = newConfig.Title end
                end
                if newConfig.Desc then
                    local descLabel = notif.Frame:FindFirstChild("NotificationDescription")
                    if descLabel then descLabel.Text = newConfig.Desc end
                end
                if newConfig.Progress ~= nil and notif.progressBar then
                    notif.progressBar.Size = UDim2.new(newConfig.Progress/100, 0, 1, 0)
                end
                if newConfig.Duration and notif.duration > 0 then
                    notif.duration = newConfig.Duration
                    if notif.timerConn then
                        notif.timerConn:Disconnect()
                        notif.timerConn = nil
                    end
                    if notif.timerLabel then
                        local startTime = tick()
                        notif.timerConn = RunService.RenderStepped:Connect(function()
                            if notif.closed or not notif.timerLabel.Parent then
                                notif.timerConn:Disconnect()
                                return
                            end
                            local elapsed = tick() - startTime
                            local remaining = math.max(0, notif.duration - elapsed)
                            notif.timerLabel.Text = string.format("%.0fs", remaining)
                            if remaining <= 0 then
                                notif.timerLabel.Text = ""
                            end
                        end)
                    end
                end
                if newConfig.Position then
                    NoyaUI:Move(id, newConfig.Position)
                end
                return notif
            end
        end
    end

    for _, queued in ipairs(notificationQueue) do
        if queued and queued.config and queued.config.ID == id then
            for k, v in pairs(newConfig) do
                queued.config[k] = v
            end
            return { id = id, queued = true, updated = true }
        end
    end

    return nil
end

-- ========== DYNAMIC POSITION CHANGE ==========
function NoyaUI:Move(id, newPosition)
    for _, list in pairs(notificationsByPosition) do
        for i, notif in ipairs(list) do
            if notif and notif.id == id and not notif.closed then
                table.remove(list, i)
                updatePositionsForPosition(notif.positionType)
                notif.positionData.posType = newPosition
                notif.positionData.isBottom = (newPosition == "BottomLeft" or newPosition == "BottomRight")
                notif.positionType = newPosition
                if not notificationsByPosition[newPosition] then
                    notificationsByPosition[newPosition] = {}
                end
                table.insert(notificationsByPosition[newPosition], notif)
                updatePositionsForPosition(newPosition)
                return true
            end
        end
    end
    return false
end

-- ========== QUICK HELPER ==========
function notify(key, extra)
    local cfg = { Duration = 5, Type = "Info" }
    local args = {
        Title = extra and extra.Title or key,
        Desc = extra and extra.Desc or "",
        Duration = cfg.Duration,
        Type = cfg.Type,
    }
    if extra then
        for k, v in pairs(extra) do args[k] = v end
    end
    NoyaUI:Notify(args)
end

return NoyaUI
