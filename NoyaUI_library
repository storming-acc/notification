function NoyaUI:NotifyV1(Config)
    Config = Config or {}
    local Title = Config.Title or "Notification"
    local Content = Config.Content or Config.Desc or ""
    local Icon = Config.Icon or nil
    local Duration = Config.Duration or 3
    local notifType = Config.Type or "Info"
    local autoSize = Config.AutoSize == nil and true or Config.AutoSize
    local customWidth = Config.Width or 300

    local typeColor = Color3.fromRGB(158, 198, 255)
    if notifType == "Error" then
        typeColor = Color3.fromRGB(255, 82, 82)
    elseif notifType == "Success" then
        typeColor = Color3.fromRGB(145, 255, 128)
    elseif notifType == "Warn" then
        typeColor = Color3.fromRGB(255, 225, 117)
    end

    if not NoyaUI.NotificationHolderV1 then
        local ScreenGui = Instance.new("ScreenGui")
        ScreenGui.Name = "NoyaUI_V1_Holder"
        ScreenGui.Parent = ParentTarget
        ScreenGui.IgnoreGuiInset = true
        ScreenGui.ResetOnSpawn = false

        local Holder = Instance.new("Frame")
        Holder.Name = "NotificationHolder"
        Holder.Size = UDim2.new(0, 320, 1, -40)
        Holder.Position = UDim2.new(1, -335, 0, 20)
        Holder.BackgroundTransparency = 1
        Holder.Parent = ScreenGui

        local UIListLayout = Instance.new("UIListLayout")
        UIListLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
        UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
        UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
        UIListLayout.Padding = UDim.new(0, 8)
        UIListLayout.Parent = Holder

        NoyaUI.NotificationHolderV1 = Holder
    end

    local textPaddingX = Icon and 42 or 24
    local contentWidth = customWidth - textPaddingX
    local contentHeight = 20

    if autoSize and Content ~= "" then
        local cleanText = Config.RichText and Content:gsub("<[^>]+>", "") or Content
        local bounds = TextService:GetTextSize(cleanText, 13, Enum.Font.BuilderSans, Vector2.new(contentWidth, 10000))
        contentHeight = math.max(20, bounds.Y + 2)
    end

    local cardHeight = Config.Height or (34 + contentHeight + 14)

    local Card = Instance.new("Frame")
    Card.Name = "NotificationCard_V1"
    Card.Size = UDim2.new(0, customWidth, 0, cardHeight)
    Card.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
    Card.BackgroundTransparency = 1
    Card.ClipsDescendants = true
    Card.Parent = NoyaUI.NotificationHolderV1

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0, 8)
    Corner.Parent = Card

    local Stroke = Instance.new("UIStroke")
    Stroke.Color = Color3.fromRGB(45, 45, 55)
    Stroke.Transparency = 1
    Stroke.Parent = Card

    local textOffsetX = 12
    if Icon then
        textOffsetX = 34
        local IconLabel = Instance.new("ImageLabel")
        IconLabel.Name = "Icon"
        IconLabel.Image = resolveImageInput(Icon) or "rbxassetid://70718918423383"
        IconLabel.ImageColor3 = typeColor
        IconLabel.BackgroundTransparency = 1
        IconLabel.Position = UDim2.new(0, 10, 0, 10)
        IconLabel.Size = UDim2.new(0, 18, 0, 18)
        IconLabel.Parent = Card
    end

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Name = "Title"
    TitleLabel.Text = Title
    TitleLabel.Font = Enum.Font.BuilderSansBold
    TitleLabel.TextSize = 14
    TitleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Position = UDim2.new(0, textOffsetX, 0, 10)
    TitleLabel.Size = UDim2.new(1, -(textOffsetX + 12), 0, 18)
    TitleLabel.RichText = Config.RichText or false
    TitleLabel.Parent = Card

    local ContentLabel = Instance.new("TextLabel")
    ContentLabel.Name = "Content"
    ContentLabel.Text = Content
    ContentLabel.Font = Enum.Font.BuilderSans
    ContentLabel.TextSize = 13
    ContentLabel.TextColor3 = Color3.fromRGB(180, 180, 190)
    ContentLabel.TextXAlignment = Enum.TextXAlignment.Left
    ContentLabel.TextYAlignment = Enum.TextYAlignment.Top
    ContentLabel.TextWrapped = true
    ContentLabel.BackgroundTransparency = 1
    ContentLabel.Position = UDim2.new(0, textOffsetX, 0, 30)
    ContentLabel.Size = UDim2.new(1, -(textOffsetX + 12), 0, contentHeight)
    ContentLabel.RichText = Config.RichText or false
    ContentLabel.Parent = Card

    local TweenInfoIn = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    TweenService:Create(Card, TweenInfoIn, { BackgroundTransparency = 0.05 }):Play()
    TweenService:Create(Stroke, TweenInfoIn, { Transparency = 0 }):Play()

    if Duration > 0 and Duration ~= math.huge then
        task.delay(Duration, function()
            local TweenInfoOut = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In)
            local FadeOut = TweenService:Create(Card, TweenInfoOut, { BackgroundTransparency = 1 })
            TweenService:Create(Stroke, TweenInfoOut, { Transparency = 1 }):Play()
            FadeOut:Play()

            FadeOut.Completed:Connect(function()
                Card:Destroy()
            end)
        end)
    end

    return {
        Frame = Card,
        Destroy = function() Card:Destroy() end
    }
end

-- ==============================================================================
-- STYLE V2: FULL NOYAUI BANNER NOTIFICATION
-- ==============================================================================
function NoyaUI:NotifyV2(config)
    local id = config.ID or NoyaUI:GenerateID()
    config.ID = id

    -- Prevent duplicates
    for _, list in pairs(notificationsByPosition) do
        for _, notif in ipairs(list) do
            if notif and notif.id == id and not notif.closed then
                return notif
            end
        end
    end

    local positionType = config.Position or "BottomRight"
    local list = notificationsByPosition[positionType]
    if not list then list = {} notificationsByPosition[positionType] = list end

    if #list >= 5 then
        local queued = { config = config, positionType = positionType, closed = false }
        table.insert(notificationQueue, queued)
        local placeholder = { id = id, queued = true, closed = false }
        queued.updateCallback = function(actualNotif)
            placeholder.queued = false
            placeholder.Frame = actualNotif.Frame
            placeholder.Gui = actualNotif.Gui
            placeholder.positionData = actualNotif.positionData
            placeholder.closeFunction = actualNotif.closeFunction
        end
        task.spawn(processQueue)
        return placeholder
    end

    -- Defaults
    local titleText = config.Title or "Notification"
    local descText = config.Desc or ""
    local duration = config.Duration or 5
    local notifType = config.Type or "Info"
    local onClick = config.OnClick
    local onClose = config.OnClose
    local onHoverEnter = config.OnHoverEnter
    local onHoverLeave = config.OnHoverLeave
    local rawImage = config.Image
    local customImage = rawImage and resolveImageInput(rawImage) or nil
    local cornerRadius = config.CornerRadius or 8
    local richText = config.RichText == true
    local customIcon = config.Icon
    local progress = config.Progress
    local groupKey = config.Group
    local soundId = config.SoundId
    local showTimer = config.ShowTimer == true
    local autoSize = config.AutoSize == nil and true or config.AutoSize

    local buttons = config.Buttons or {}
    if #buttons > 2 then buttons = {buttons[1], buttons[2]} end

    local BUTTON_HEIGHT = 30
    local BUTTON_GAP = 23
    local IMAGE_HEIGHT = config.ImageHeight or 60
    local PROGRESS_HEIGHT = 6
    local PROGRESS_PADDING = 4

    local camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(1920, 1080)

    -- Dynamic Custom Size Clamped to Screen
    local maxWidth = viewport.X - 40
    local notifWidth = math.min(config.Width or 200, maxWidth)

    -- Dynamic Text Scaling Calculation
    local descHeight = 28
    local descWidth = notifWidth - 32
    
    if autoSize and descText and descText ~= "" then
        local cleanText = richText and descText:gsub("<[^>]+>", "") or descText
        local bounds = TextService:GetTextSize(cleanText, 10, Enum.Font.Gotham, Vector2.new(descWidth, 10000))
        descHeight = math.max(28, bounds.Y + 4)
    end

    local extraHeight = 0
    if #buttons > 0 then extraHeight = BUTTON_HEIGHT + BUTTON_GAP + 4 end
    if progress then extraHeight = extraHeight + PROGRESS_HEIGHT + PROGRESS_PADDING + 4 end
    local imageHeight = customImage and IMAGE_HEIGHT or 0

    local notifHeight = config.Height and (config.Height + imageHeight + (imageHeight > 0 and 5 or 0) + extraHeight)
                        or (22 + descHeight + (imageHeight > 0 and imageHeight + 5 or 0) + extraHeight + 15)

    local maxHeight = viewport.Y - 60
    if notifHeight > maxHeight then
        notifHeight = maxHeight
        descHeight = maxHeight - (22 + (imageHeight > 0 and imageHeight + 5 or 0) + extraHeight + 15)
    end

    local isLeftSide = (positionType == "TopLeft" or positionType == "BottomLeft")

    local typeColor, defaultIcon
    if notifType == "Error" then
        typeColor = Color3.fromRGB(255, 82, 82)
        defaultIcon = "rbxassetid://113114601887005"
    elseif notifType == "Success" then
        typeColor = Color3.fromRGB(145, 255, 128)
        defaultIcon = "rbxassetid://18567015051"
    elseif notifType == "Warn" then
        typeColor = Color3.fromRGB(255, 225, 117)
        defaultIcon = "rbxassetid://14863060512"
    else
        typeColor = Color3.fromRGB(158, 198, 255)
        defaultIcon = "rbxassetid://70718918423383"
    end
    local iconId = customIcon and resolveImageInput(customIcon) or defaultIcon

    if groupKey then
        if not notificationGroups[groupKey] then
            notificationGroups[groupKey] = { count = 0, notifications = {} }
        end
        notificationGroups[groupKey].count = notificationGroups[groupKey].count + 1
    end

    local isBottom = (positionType == "BottomLeft" or positionType == "BottomRight")

    if not notificationsByPosition[positionType] then
        notificationsByPosition[positionType] = {}
    end
    local positionList = notificationsByPosition[positionType]

    if #positionList >= 5 then
        local oldest = table.remove(positionList, 1)
        if oldest and oldest.Gui then oldest.Gui:Destroy() end
        updatePositionsForPosition(positionType)
    end

